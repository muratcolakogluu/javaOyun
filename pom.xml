<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cryptdelver</groupId>
    <artifactId>cryptdelver</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>CryptDelver</name>
    <description>2D prosedurel rogue-like zindan kasifi</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <junit.version>5.11.3</junit.version>
        <main.class>com.cryptdelver.Main</main.class>

        <!--
            Paketlenmis surumun giris noktasi. Application turunden olmadigi
            icin tek jar icinden calisabiliyor; gerekcesi Launcher'in
            javadoc'unda.
        -->
        <launcher.class>com.cryptdelver.Launcher</launcher.class>

        <!-- Her yerde calisan jar'a hangi Mac mimarisi konacak. -->
        <mac.mimari>mac-aarch64</mac.mimari>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Ses efektleri icin AudioClip -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        "Her yerde calisan tek jar" profili.

        JavaFX'in yerel kutuphaneleri isletim sistemine gore ayri jar'larda
        duruyor ve Maven varsayilan olarak yalnizca derlemenin yapildigi
        sistemin jar'ini cekiyor. Windows'ta uretilen sisman jar bu yuzden
        Mac'te acilmiyor: sinif dosyalari var ama .dylib'ler yok.

        Bu profil Windows, Linux ve Mac kutuphanelerini bir arada koyuyor.
        Varsayilan derlemeye eklemedim: gelistirirken ve test ederken diger
        platformlarin kutuphanesini indirip sinif yoluna koymanin hicbir
        faydasi yok.

        Mac'in iki mimarisi ayni dosya adlarini kullaniyor (libglass.dylib),
        yani ikisi tek jar'a sigmiyor: birlestirme sirasinda biri otekinin
        uzerine yaziliyor ve yanlis mimari sessizce icerde kaliyor. O yuzden
        mimari bir secim ve acikca yaziliyor. Varsayilan Apple Silicon,
        cunku 2020 sonu sonrasi butun Mac'ler oyle. Intel Mac icin:

            mvn -Ptumplatformlar -Dmac.mimari=mac -DskipTests package

        Kullanim: mvn -Ptumplatformlar -DskipTests package
    -->
    <profiles>
        <profile>
            <id>tumplatformlar</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${mac.mimari}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${mac.mimari}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${mac.mimari}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-media</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${mac.mimari}</classifier>
                </dependency>

                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-media</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
                Tek dosyalik "sisman" jar: oyun, JavaFX ve JavaFX'in Windows
                yerel kutuphaneleri bir arada. jpackage bunu alip icine bir
                Java calisma zamani koyuyor, yani karsi tarafta Java kurulu
                olmasi gerekmiyor.

                Imzali jar'larin imza dosyalari atiliyor: birlestirilmis jar
                zaten yeni bir jar ve eski imzalar dogrulanamadigi icin
                calistirmayi engelliyor.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>oyun</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${launcher.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- mvn javafx:run ile oyunu calistirir -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
